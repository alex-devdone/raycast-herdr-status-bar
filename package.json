{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "agent-status-bar",
  "title": "Agent Status Bar",
  "description": "Menu bar view of live AI coding agents (Claude Code, Codex) via herdr: count, type, state, token use and session runtime",
  "icon": "icon.png",
  "author": "oleksandr",
  "categories": ["Developer Tools"],
  "license": "MIT",
  "commands": [
    {
      "name": "agents",
      "title": "Agents",
      "description": "Show running AI coding agents and their stats in the menu bar",
      "mode": "menu-bar",
      "interval": "10s"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.87.0",
    "@raycast/utils": "^1.17.0"
  },
  "overrides": {
    "@types/react": "19.0.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "eslint": "^8.57.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "tsx src/lib.test.ts",
    "prepublishOnly": "echo \"Error: no publish\" && exit 1",
    "publish": "npx @raycast/api@latest publish"
  }
}
